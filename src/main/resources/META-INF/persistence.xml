<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="is1PU" transaction-type="JTA">
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <jta-data-source>java:jboss/datasources/ExampleDS</jta-data-source>

        <class>itmo.is1.entity.Person</class>
        <class>itmo.is1.entity.Coordinates</class>
        <class>itmo.is1.entity.Location</class>
        <class>itmo.is1.entity.User</class>
        <class>itmo.is1.entity.ImportOperation</class>
        <class>itmo.is1.entity.PersonChange</class>
        <class>itmo.is1.entity.ZonedDateTimeConverter</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <!-- Разделяемый (L2) кэш EclipseLink отключён: чтение из кэша не доходит до PostgreSQL,
             и SERIALIZABLE не видит такие чтения — em.find() мог вернуть уже удалённый другим
             пользователем объект. Кроме того, без кэша сразу видны правки БД в обход
             приложения (например, назначение роли ADMIN через UPDATE). -->
        <shared-cache-mode>NONE</shared-cache-mode>

        <properties>
            <property name="jboss.as.jpa.providerModule" value="org.eclipse.persistence"/>
            <property name="eclipselink.target-database" value="PostgreSQL"/>
            <property name="eclipselink.target-server" value="org.jipijapa.eclipselink.WildFlyServerPlatform"/>
            <property name="eclipselink.logging.level" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
            <property name="eclipselink.ddl-generation" value="none"/>
            <property name="eclipselink.weaving" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
