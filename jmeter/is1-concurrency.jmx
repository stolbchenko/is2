<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="ИС Person: одновременная работа нескольких пользователей">
  <stringProp name="TestPlan.comments">Запуск: jmeter -n -t is1-concurrency.jmx -Jthreads=10 -Juser.classpath=путь/к/postgresql.jar -l results.jtl. Группы выполняются по очереди, внутри группы потоки стартуют одновременно (Synchronizing Timer). Драйвер PostgreSQL нужен, чтобы назначить двум пользователям роль ADMIN (её можно выдать только в БД); параметры БД: -JdbUrl, -JdbUser, -JdbPassword.</stringProp>
  <boolProp name="TestPlan.functional_mode">false</boolProp>
  <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
  <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
  <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments">
    <collectionProp name="Arguments.arguments">
<elementProp name="HOST" elementType="Argument">
  <stringProp name="Argument.name">HOST</stringProp>
  <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
  <stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="PORT" elementType="Argument">
  <stringProp name="Argument.name">PORT</stringProp>
  <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
  <stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="THREADS" elementType="Argument">
  <stringProp name="Argument.name">THREADS</stringProp>
  <stringProp name="Argument.value">${__P(threads,10)}</stringProp>
  <stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="DB_URL" elementType="Argument">
  <stringProp name="Argument.name">DB_URL</stringProp>
  <stringProp name="Argument.value">${__P(dbUrl,jdbc:postgresql://localhost:55432/studs)}</stringProp>
  <stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="DB_USER" elementType="Argument">
  <stringProp name="Argument.name">DB_USER</stringProp>
  <stringProp name="Argument.value">${__P(dbUser,is1)}</stringProp>
  <stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="DB_PASSWORD" elementType="Argument">
  <stringProp name="Argument.name">DB_PASSWORD</stringProp>
  <stringProp name="Argument.value">${__P(dbPassword,is1pass)}</stringProp>
  <stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="LOOPS" elementType="Argument">
  <stringProp name="Argument.name">LOOPS</stringProp>
  <stringProp name="Argument.value">${__P(loops,3)}</stringProp>
  <stringProp name="Argument.metadata">=</stringProp>
</elementProp>
    </collectionProp>
  </elementProp>
</TestPlan>
<hashTree>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Журналировать ответы 5xx">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">if (prev.getResponseCode().startsWith('5')) {
    log.warn('HTTP ' + prev.getResponseCode() + ' в «' + prev.getSampleLabel() + '»: '
            + prev.getResponseDataAsString().take(500))
}</stringProp>
</JSR223PostProcessor>
<hashTree>

</hashTree>
<SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="0. Подготовка: владелец, два администратора и общие объекты">
  <stringProp name="TestPlan.comments">Регистрирует владельца и двух пользователей, назначает им роль ADMIN через JDBC (через API роль не выдаётся) и создаёт объекты владельца, которые затем одновременно изменяют и удаляют администраторы в группах 5–7.</stringProp>
  <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
  <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
    <stringProp name="LoopController.loops">1</stringProp>
    <boolProp name="LoopController.continue_forever">false</boolProp>
  </elementProp>
  <stringProp name="ThreadGroup.num_threads">1</stringProp>
  <stringProp name="ThreadGroup.ramp_time">0</stringProp>
  <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
  <boolProp name="ThreadGroup.scheduler">false</boolProp>
</SetupThreadGroup>
<hashTree>
<JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Идентификатор прогона и счётчики">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Идентификатор прогона: все имена и координаты в сценарии уникальны для прогона,
// поэтому сценарий можно запускать повторно на той же БД.
long run = System.currentTimeMillis()
props.put('run', String.valueOf(run))
props.put('ry', String.valueOf(-(run % 1000000000L)))
['uniq201', 'coord201', 'import200', 'del204', 'delUpd200', 'upd200', 'refDel204', 'ref201'].each {
    props.put(it, new java.util.concurrent.atomic.AtomicInteger())
}
props.put('putHeights', java.util.Collections.synchronizedSet(new HashSet&lt;String&gt;()))
SampleResult.setResponseData('run=' + run + ', ry=' + props.get('ry'), 'UTF-8')</stringProp>
</JSR223Sampler>
<hashTree>

</hashTree>
