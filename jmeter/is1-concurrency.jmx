<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="id → переменные">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Сохраняем id объекта, его версию, id координат и локации в переменные потока
if (prev.getResponseCode() == '201') {
    def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    vars.put('pid', json.id as String)
    vars.put('pver', json.version as String)
    vars.put('cid', json.coordinates.id as String)
    vars.put('lid', json.location.id as String)
}</stringProp>
</JSR223PostProcessor>
