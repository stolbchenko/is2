  <stringProp name="script">def list = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def same = list.findAll { it.x == '-999999' &amp;&amp; it.y == props.get('ry') }
int created = props.get('coord201').get()
if (same.size() != 1 || created != 1) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Нарушена уникальность координат: координат (-999999; ${props.get('ry')}) &quot;
            + &quot;в БД — ${same.size()}, успешных ответов 201 — ${created}, ожидалось ровно по 1&quot;)
}</stringProp>
