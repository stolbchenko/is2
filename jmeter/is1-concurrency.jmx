<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Файл импорта">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters">crud</stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Пишет файл импорта для этого потока. Параметр: &quot;crud&quot; — две уникальные записи,
// &quot;overlap&quot; — запись с общим для всех потоков именем + запись с уникальным именем.
import groovy.json.JsonOutput

def run = props.get('run')
def ry = props.get('ry')
int t = ctx.getThreadNum() + 1
int iter = vars.getIteration()
def record = { String name, long x -&gt;
    [name: name, hairColor: 'YELLOW', height: '165,5',
     coordinates: [x: x.toString(), y: ry], location: [x: x.toString(), y: '2', z: ry]]
}
def records
if (Parameters == 'crud') {
    long base = -(200000L + t * 100 + iter * 2)
    records = [record(&quot;impok${run}_${t}_${iter}_a&quot;, base), record(&quot;impok${run}_${t}_${iter}_b&quot;, base - 1)]
} else {
    long base = -(500000L + t * 2)
    records = [record(&quot;impc${run}&quot;, base), record(&quot;impu${run}_${t}&quot;, base - 1)]
}
def file = new File(System.getProperty('java.io.tmpdir'), &quot;is1-import-${run}-${Parameters}-${t}-${iter}.json&quot;)
file.setText(JsonOutput.toJson(records), 'UTF-8')
file.deleteOnExit()
vars.put('importFile', file.absolutePath)</stringProp>
</JSR223PreProcessor>
<hashTree>

</hashTree>
<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Код ответа ∈ {200}">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters">200</stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Ожидаемые коды ответа передаются параметром: &quot;201,409&quot;. Всё остальное (в т. ч. 5xx) — ошибка.
def expected = Parameters.split(',') as List
if (expected.contains(prev.getResponseCode())) {
    prev.setSuccessful(true)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Ожидался код ' + Parameters + ', получен ' + prev.getResponseCode()
            + ': ' + prev.getResponseDataAsString().take(300))
}</stringProp>
</JSR223Assertion>
<hashTree>

</hashTree>
</hashTree>
</hashTree>
