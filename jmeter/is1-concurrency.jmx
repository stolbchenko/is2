<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Ровно одни координаты и один ответ 201">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
