<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Успешно ровно одно изменение, его значение сохранилось">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Все администраторы меняли одну и ту же версию: успешно ровно одно изменение, его значение и сохранилось
def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def heights = props.get('putHeights')
int ok = props.get('upd200').get()
int expectedVersion = (props.get('updVersion') as int) + 1
if (ok != 1 || heights.size() != 1 || !heights.contains(json.height) || json.version != expectedVersion) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Одновременное изменение: успешных ответов 200 — ${ok} (ожидался 1), &quot;
            + &quot;итоговый рост ${json.height}, успешные изменения ${heights}, версия ${json.version} (ожидалась ${expectedVersion})&quot;)
}</stringProp>
</JSR223Assertion>
<hashTree>

</hashTree>
