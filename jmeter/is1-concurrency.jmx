<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Роль ADMIN действует">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (prev.getResponseCode() != '200' || json.admin != true) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Пользователь не стал администратором: ' + prev.getResponseCode() + ' '
            + prev.getResponseDataAsString().take(300))
}</stringProp>
</JSR223Assertion>
<hashTree>

</hashTree>
