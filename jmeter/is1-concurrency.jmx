<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Координаты есть тогда и только тогда, когда используются">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Координаты удалённого объекта должны остаться, если кто-то успел к ним привязаться, и исчезнуть, если нет
def list = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
boolean exists = list.any { (it.id as String) == props.get('refCoords') }
boolean referenced = props.get('ref201').get() &gt; 0
if (exists != referenced) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Координаты #${props.get('refCoords')}: существуют=${exists}, &quot;
            + &quot;но привязанных объектов создано ${props.get('ref201').get()}&quot;)
}</stringProp>
</JSR223Assertion>
