<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Сохранились только записи успешного импорта">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Из уникальных записей должна остаться только запись успешного импорта:
// у отклонённых файлов не должно сохраниться ничего (атомарность импорта)
def json = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (json.total != props.get('import200').get()) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Импорт неатомарен: уникальных записей в БД — ${json.total}, &quot;
            + &quot;успешных импортов — ${props.get('import200').get()}&quot;)
}</stringProp>
</JSR223Assertion>
