  <stringProp name="HTTPSampler.port">${PORT}</stringProp>
  <stringProp name="HTTPSampler.protocol">http</stringProp>
  <stringProp name="HTTPSampler.contentEncoding">UTF-8</stringProp>
  <stringProp name="HTTPSampler.path">/is1/api/persons/import</stringProp>
  <stringProp name="HTTPSampler.method">POST</stringProp>
  <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
  <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
  <boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
  <elementProp name="HTTPsampler.Files" elementType="HTTPFileArgs">
    <collectionProp name="HTTPFileArgs.files">
      <elementProp name="${importFile}" elementType="HTTPFileArg">
        <stringProp name="File.path">${importFile}</stringProp>
        <stringProp name="File.paramname">file</stringProp>
        <stringProp name="File.mimetype">application/json</stringProp>
      </elementProp>
    </collectionProp>
  </elementProp>
  <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
    <collectionProp name="Arguments.arguments"/>
  </elementProp>
</HTTPSamplerProxy>
<hashTree>
<JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Файл импорта">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters">overlap</stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Пишет файл импорта для этого потока. Параметр: &quot;crud&quot; — две уникальные записи,
// &quot;overlap&quot; — запись с общим для всех потоков именем + запись с уникальным именем.
import groovy.json.JsonOutput

def run = props.get('run')
def ry = props.get('ry')
int t = ctx.getThreadNum() + 1
int iter = vars.getIteration()
def record = { String name, long x -&gt;
    [name: name, hairColor: 'YELLOW', height: '165,5',
     coordinates: [x: x.toString(), y: ry], location: [x: x.toString(), y: '2', z: ry]]
}
def records
if (Parameters == 'crud') {
    long base = -(200000L + t * 100 + iter * 2)
    records = [record(&quot;impok${run}_${t}_${iter}_a&quot;, base), record(&quot;impok${run}_${t}_${iter}_b&quot;, base - 1)]
} else {
    long base = -(500000L + t * 2)
    records = [record(&quot;impc${run}&quot;, base), record(&quot;impu${run}_${t}&quot;, base - 1)]
}
def file = new File(System.getProperty('java.io.tmpdir'), &quot;is1-import-${run}-${Parameters}-${t}-${iter}.json&quot;)
file.setText(JsonOutput.toJson(records), 'UTF-8')
file.deleteOnExit()
vars.put('importFile', file.absolutePath)</stringProp>
</JSR223PreProcessor>
<hashTree>

</hashTree>
<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Счётчик ответов 200 → import200">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters">200 import200</stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Параметр &quot;201 counterName&quot;: считаем ответы с этим кодом в общий счётчик (для итоговой проверки)
def (code, counter) = Parameters.split(' ')
if (prev.getResponseCode() == code) {
    props.get(counter).incrementAndGet()
}</stringProp>
</JSR223PostProcessor>
<hashTree>

</hashTree>
<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Код ответа ∈ {200,400}">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters">200,400</stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Ожидаемые коды ответа передаются параметром: &quot;201,409&quot;. Всё остальное (в т. ч. 5xx) — ошибка.
def expected = Parameters.split(',') as List
if (expected.contains(prev.getResponseCode())) {
    prev.setSuccessful(true)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Ожидался код ' + Parameters + ', получен ' + prev.getResponseCode()
            + ': ' + prev.getResponseDataAsString().take(300))
}</stringProp>
</JSR223Assertion>
<hashTree>

</hashTree>
</hashTree>
</hashTree>
<ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="5. Два администратора одновременно изменяют один объект">
  <stringProp name="TestPlan.comments">Два администратора (чётные и нечётные потоки) одновременно меняют чужой объект; все видели одну и ту же версию, у каждого потока свой рост. Оптимистическая блокировка: ровно одно изменение успешно (200), остальные отклонены как сделанные по устаревшей версии (409) — правка не теряется молча. Итог — значение успешного изменения.</stringProp>
  <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
  <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController">
    <stringProp name="LoopController.loops">1</stringProp>
    <boolProp name="LoopController.continue_forever">false</boolProp>
  </elementProp>
  <stringProp name="ThreadGroup.num_threads">${THREADS}</stringProp>
  <stringProp name="ThreadGroup.ramp_time">0</stringProp>
  <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
  <boolProp name="ThreadGroup.scheduler">false</boolProp>
</ThreadGroup>
<hashTree>
