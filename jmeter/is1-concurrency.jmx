<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Счётчик ответов 201 → ref201">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters">201 ref201</stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Параметр &quot;201 counterName&quot;: считаем ответы с этим кодом в общий счётчик (для итоговой проверки)
def (code, counter) = Parameters.split(' ')
if (prev.getResponseCode() == code) {
    props.get(counter).incrementAndGet()
}</stringProp>
</JSR223PostProcessor>
