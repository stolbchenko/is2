<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Успешна ровно одна операция, итог ей соответствует">
  <stringProp name="scriptLanguage">groovy</stringProp>
  <stringProp name="parameters"></stringProp>
  <stringProp name="filename"></stringProp>
  <stringProp name="cacheKey">true</stringProp>
  <stringProp name="script">// Все операции шли по одной версии: успешна ровно одна — удаление (объекта нет) или изменение (объект изменён)
int deleted = props.get('del204').get()
int updated = props.get('delUpd200').get()
String code = prev.getResponseCode()
boolean consistent = deleted + updated == 1 &amp;&amp; (deleted == 1 ? code == '404'
        : code == '200' &amp;&amp; new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString()).height == '180')
if (!consistent) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Изменение + удаление одного объекта: удалений 204 — ${deleted}, изменений 200 — ${updated} &quot;
            + &quot;(ожидалась ровно одна успешная операция), объект после сценария отвечает ${code}&quot;)
} else {
    prev.setSuccessful(true)
}</stringProp>
</JSR223Assertion>
<hashTree>

</hashTree>
